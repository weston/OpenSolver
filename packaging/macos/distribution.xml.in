<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>OpenSolver @VERSION@</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <domains enable_localSystem="true"/>
  <allowed-os-versions><os-version min="@MACOS_MIN@"/></allowed-os-versions>
  <choices-outline><line choice="default"><line choice="app"/></line></choices-outline>
  <choice id="default"/>
  <choice id="app" visible="false"><pkg-ref id="@BUNDLE_ID@.pkg"/></choice>
  <pkg-ref id="@BUNDLE_ID@.pkg" version="@VERSION@" onConclusion="none">OpenSolver.pkg</pkg-ref>
</installer-gui-script>
