// The launcher's resources (#565): its icon, its manifest and the version Explorer shows.
// packaging/windows/build.sh fills in @VERSION@, @VERSION4@ and @VERSIONCOMMA@.
#include <winver.h>

1 ICON "icon.ico"
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSIONCOMMA@
PRODUCTVERSION @VERSIONCOMMA@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "WSolver"
      VALUE "FileDescription", "WSolver"
      VALUE "FileVersion", "@VERSION4@"
      VALUE "InternalName", "WSolver"
      VALUE "OriginalFilename", "WSolver.exe"
      VALUE "ProductName", "WSolver"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
